# ---------------------------------------------------------------------------
# Secrets: never commit these. The bot reads its token from DISCORD_TOKEN;
# the extra patterns below are a safety net for stray local token files.
# ---------------------------------------------------------------------------
.discord_token
.env
.env.*
!.env.example
*.token
secrets.json

# ---------------------------------------------------------------------------
# Runtime state written by the bot. Not secret, but committing it
# means a fresh clone starts with someone else's "already announced" list and
# silently skips real uploads.
# ---------------------------------------------------------------------------
panel_state.json
notifications_state.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Runtime data and server-side backups
data/
*.bak
