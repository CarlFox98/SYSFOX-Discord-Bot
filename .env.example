# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
# On bot-hosting.net, set these in the panel's Startup/Variables section
# instead of using a file.

# Required. Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=

# Required for Twitch go-live and clip alerts. Without these the bot still
# runs, but both Twitch loops stay off (it says so on boot).
# From https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional overrides. Defaults are baked into main.py.
# TWITCH_LOGIN=neothefox98
# YOUTUBE_CHANNEL_ID=UCIJQfv1gmlQrdtmIyq170_g
