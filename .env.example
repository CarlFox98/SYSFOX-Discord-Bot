# ============================================================================
# SYSFOX environment variables
# ----------------------------------------------------------------------------
# On bot-hosting.net: put these in the panel's Startup tab -> Environment
# Variables. Do NOT commit a real .env to git.
# For local development: copy this file to ".env" and fill it in.
# ============================================================================

# --- Discord core ---
DISCORD_TOKEN=your-bot-token
GUILD_ID=000000000000000000

# --- Twitch (create an app at https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_LOGIN=NeoTheFox98

# --- YouTube (no API key needed; uses the channel RSS feed) ---
YOUTUBE_CHANNEL_ID=UCIJQfv1gmlQrdtmIyq170_g

# --- Destination channel IDs (right-click channel -> Copy Channel ID) ---
LIVE_CHANNEL_ID=000000000000000000
CLIPS_CHANNEL_ID=000000000000000000
VIDEOS_CHANNEL_ID=000000000000000000
SHORTS_CHANNEL_ID=000000000000000000
PANEL_CHANNEL_ID=000000000000000000
ALERT_CHANNEL_ID=000000000000000000

# --- Opt-in ping role IDs (Server Settings -> Roles -> Copy Role ID) ---
LIVE_ROLE_ID=000000000000000000
CLIPS_ROLE_ID=000000000000000000
VIDEOS_ROLE_ID=000000000000000000
SHORTS_ROLE_ID=000000000000000000

# --- Optional tuning (sensible defaults if omitted) ---
HEALTH_PORT=8080
POLL_INTERVAL_LIVE=60
POLL_INTERVAL_CLIPS=300
POLL_INTERVAL_YOUTUBE=300
STATE_PATH=data/state.json
